# Variables para ejecutar el backend FUERA de Docker (desarrollo local con Node.js).
# Para la demostracion con Docker Compose use el .env de la raiz del repositorio.
NODE_ENV=development
BACKEND_PORT=3000
LOG_LEVEL=log
SEED_ON_START=true
PAGINATION_MAX_LIMIT=100

# PostgreSQL alcanzable desde el host (por ejemplo, docker-compose.test.yml publica 127.0.0.1:55432)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USER=stockguard
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=stockguard

# Pruebas de integracion (BD separada; las pruebas TRUNCAN sus tablas)
TEST_POSTGRES_DB=stockguard_test
