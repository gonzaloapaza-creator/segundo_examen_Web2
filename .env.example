# ============================================================
# StockGuard - Variables de entorno para Docker Compose
# Copiar a .env antes de ejecutar `docker compose up --build -d`
# Estos valores son SOLO para demostracion local.
# ============================================================

# --- Gateway (unico puerto publicado al host) ---
GATEWAY_PORT=8080
# Origenes permitidos por CORS, separados por "|" (regex-safe, sin espacios).
# Ejemplo para el futuro frontend Vite: http://localhost:5173|http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173|http://127.0.0.1:5173|http://localhost:8080
# Rate limiting por IP (peticiones por segundo y rafaga permitida)
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
# Tamano maximo del cuerpo de la solicitud
CLIENT_MAX_BODY_SIZE=1m
# Tiempos de espera hacia el backend (segundos)
PROXY_READ_TIMEOUT=30
PROXY_CONNECT_TIMEOUT=5

# --- Backend NestJS ---
BACKEND_PORT=3000
NODE_ENV=production
LOG_LEVEL=log
# Cargar datos de demostracion al arrancar (idempotente)
SEED_ON_START=true
# Limite maximo de elementos por pagina en listados
PAGINATION_MAX_LIMIT=100

# --- PostgreSQL ---
POSTGRES_DB=stockguard
POSTGRES_USER=stockguard
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_HOST=db
POSTGRES_PORT=5432
