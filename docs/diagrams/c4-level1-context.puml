@startuml c4-level1-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title StockGuard - Diagrama C4 Nivel 1 (Contexto del sistema)

Person(operator, "Operador de tienda", "Encargado del inventario de una tienda de accesorios tecnologicos. Mantiene el catalogo, registra entradas/salidas y consulta stock y reportes.")
Person(evaluator, "Evaluador / Desarrollador", "Revisa y prueba la API durante la demostracion local.")

System(stockguard, "StockGuard", "API REST de control de inventario: catalogo (categorias y productos), movimientos auditables e inmutables con idempotencia y reversiones, reportes de stock bajo y resumen.")

System_Ext(clients, "Clientes HTTP de prueba", "Swagger UI (servida por el propio sistema), Postman y cURL. No existe un frontend propio.")

Rel(operator, clients, "Opera el inventario mediante", "Swagger UI / Postman / cURL")
Rel(evaluator, clients, "Explora la documentacion y ejecuta pruebas mediante")
Rel(clients, stockguard, "Peticiones HTTP/JSON", "HTTP :8080 -> /api/v1, /docs, /health")

SHOW_LEGEND()
@enduml
