# Normaliza finales de linea a LF en el repositorio y en el checkout.
# Imprescindible para los scripts y configuraciones que se copian dentro de contenedores Linux
# (un checkout con CRLF en Windows romperia /docker-entrypoint.d/*.sh y nginx).
* text=auto eol=lf

*.sh text eol=lf
*.conf text eol=lf
*.template text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.md text eol=lf
*.puml text eol=lf

# Scripts de PowerShell pueden mantener CRLF
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.svg text eol=lf
